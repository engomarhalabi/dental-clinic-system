# قاعدة البيانات (Neon PostgreSQL أو أي PostgreSQL آخر)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# إعدادات الخادم
PORT=5000
NODE_ENV=development

# JWT (المصادقة)
JWT_SECRET="غيّر_هذا_إلى_نص_عشوائي_طويل_وسري_جدا"
JWT_EXPIRES_IN="7d"

# CORS - رابط الفرونت اند
FRONTEND_URL="http://localhost:5173"
