// نظام إدارة عيادة الأسنان - Prisma Schema
// المرحلة 1: البنية التحتية الأساسية

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== المستخدمون والأدوار ====================

enum Role {
  ADMIN         // مدير
  DENTIST       // طبيب
  RECEPTIONIST  // استقبال
  ACCOUNTANT    // محاسب
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  password     String   // مشفرة bcrypt
  role         Role
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // علاقات: الطبيب مرتبط بالمواعيد والزيارات وسجل تاريخ السن كمنفذ للإجراء
  appointments Appointment[] @relation("DentistAppointments")
  visits       Visit[]       @relation("DentistVisits")
  toothHistory ToothHistory[] @relation("PerformedBy")

  @@map("users")
}

// ==================== الكراسي / الوحدات ====================

model Chair {
  id           String        @id @default(uuid())
  name         String        // مثال: كرسي 1، كرسي 2
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())

  appointments Appointment[]

  @@map("chairs")
}

// ==================== المرضى ====================

enum Gender {
  MALE
  FEMALE
}

model Patient {
  id            String    @id @default(uuid())
  fullName      String
  phone         String
  whatsapp      String?   // رقم واتساب لإرسال الرسائل التلقائية (قد يختلف عن الهاتف)
  dateOfBirth   DateTime?
  gender        Gender?
  address       String?
  medicalNotes  String?   // ملاحظات طبية عامة (حساسية، أمراض مزمنة...)
  fileNumber    String?   @unique // رقم ملف المريض (اختياري)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  appointments  Appointment[]
  visits        Visit[]
  toothRecords  ToothRecord[]
  invoices      Invoice[]

  @@index([phone])
  @@index([fullName])
  @@map("patients")
}

// ==================== المواعيد ====================

enum AppointmentStatus {
  SCHEDULED   // محجوز
  CONFIRMED   // مؤكد
  COMPLETED   // منجز
  CANCELLED   // ملغى
  NO_SHOW     // لم يحضر
}

model Appointment {
  id          String            @id @default(uuid())
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)

  dentistId   String?
  dentist     User?             @relation("DentistAppointments", fields: [dentistId], references: [id])

  chairId     String?
  chair       Chair?            @relation(fields: [chairId], references: [id])

  scheduledAt DateTime          // تاريخ ووقت الموعد
  durationMin Int               @default(30)
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  visit       Visit?            // الزيارة الناتجة عن هذا الموعد (إن وجدت)

  @@index([scheduledAt])
  @@index([patientId])
  @@map("appointments")
}

// ==================== الزيارات ====================

model Visit {
  id            String    @id @default(uuid())
  patientId     String
  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  appointmentId String?   @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  dentistId     String?
  dentist       User?     @relation("DentistVisits", fields: [dentistId], references: [id])

  visitDate     DateTime  @default(now())
  diagnosis     String?   // التشخيص
  doctorNotes   String?   // ملاحظات الطبيب على الزيارة
  followUpAt    DateTime? // موعد متابعة مقترح

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  toothHistory  ToothHistory[]
  invoice       Invoice?

  @@index([patientId])
  @@map("visits")
}

// ==================== المخطط السني (الأسنان) ====================
// نظام ترقيم FDI (11, 12, 13... 48)

model ToothRecord {
  id            String   @id @default(uuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  toothNumber   String   // ترقيم FDI مثل "11", "26", "48"
  currentStatus String?  // الحالة الحالية للسن: سليم/محشو/مقلوع/تاج... الخ
  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  history       ToothHistory[]

  @@unique([patientId, toothNumber]) // سن واحد لكل مريض بسجل واحد
  @@map("tooth_records")
}

// سجل تاريخ كل إجراء تم على سن معين (الأهم لتتبع تاريخ العلاج بالكامل)

model ToothHistory {
  id            String       @id @default(uuid())
  toothRecordId String
  toothRecord   ToothRecord  @relation(fields: [toothRecordId], references: [id], onDelete: Cascade)

  visitId       String?
  visit         Visit?       @relation(fields: [visitId], references: [id])

  performedById String?
  performedBy   User?        @relation("PerformedBy", fields: [performedById], references: [id])

  procedure     String       // نوع الإجراء: حشو، قلع، تنظيف، تركيب تاج...
  statusAfter   String?      // حالة السن بعد الإجراء
  notes         String?
  procedureDate DateTime     @default(now())

  createdAt     DateTime     @default(now())

  @@index([toothRecordId])
  @@map("tooth_history")
}

// ==================== الفواتير ====================

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model Invoice {
  id             String        @id @default(uuid())
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)

  visitId        String?       @unique
  visit          Visit?        @relation(fields: [visitId], references: [id])

  treatmentType  String        // نوع العلاج المفوتر: زراعة، تقويم، حشو... (السعر يعتمد على النوع وليس عدد الزيارات)
  description    String?
  amount         Decimal       @db.Decimal(10, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(10, 2)
  status         InvoiceStatus @default(UNPAID)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([patientId])
  @@map("invoices")
}
