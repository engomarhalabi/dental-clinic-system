// ==========================================
// نظام إدارة عيادة الأسنان — Prisma Schema
// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  ADMIN
  DENTIST
  RECEPTIONIST
  ACCOUNTANT
}

enum Language {
  AR
  EN
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum TreatmentPlanStatus {
  ONGOING
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum WhatsAppMessageType {
  VISIT_SUMMARY
  APPOINTMENT_REMINDER
  OTHER
}

enum WhatsAppStatus {
  PENDING
  SENT
  FAILED
}

// ---------- Core: Users & Roles ----------

model User {
  id            String   @id @default(cuid())
  fullName      String
  email         String   @unique
  passwordHash  String
  role          Role
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dentistProfile   DentistProfile?
  chairShifts      ChairShift[]        @relation("DentistShifts")
  appointments     Appointment[]       @relation("AppointmentDentist")
  toothProcedures  ToothProcedure[]    @relation("PerformedBy")
  paymentsReceived Payment[]           @relation("ReceivedBy")

  @@map("users")
}

model DentistProfile {
  id         String  @id @default(cuid())
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty  String?
  notes      String?

  @@map("dentist_profiles")
}

// ---------- Clinic Structure: Chairs & Shifts ----------

model Chair {
  id           String   @id @default(cuid())
  name         String   // مثال: "كرسي 1" / "Chair 1"
  locationNote String?
  isActive     Boolean  @default(true)

  shifts       ChairShift[]
  appointments Appointment[]

  @@map("chairs")
}

// يحل علاقة N:N بين الكرسي والطبيب عبر فترات زمنية محددة
model ChairShift {
  id        String   @id @default(cuid())
  chairId   String
  chair     Chair    @relation(fields: [chairId], references: [id], onDelete: Cascade)
  dentistId String
  dentist   User     @relation("DentistShifts", fields: [dentistId], references: [id], onDelete: Cascade)
  dayOfWeek Int      // 0-6 (الأحد-السبت) لجدول أسبوعي متكرر
  startTime String   // "09:00"
  endTime   String   // "14:00"

  @@map("chair_shifts")
}

// ---------- Patients ----------

model Patient {
  id                 String    @id @default(cuid())
  fullName           String
  phone              String
  dateOfBirth        DateTime?
  gender             String?
  address            String?
  medicalHistoryNote String?
  preferredLanguage  Language  @default(AR)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  appointments    Appointment[]
  treatmentPlans  TreatmentPlan[]
  toothProcedures ToothProcedure[]
  invoices        Invoice[]
  whatsappLogs    WhatsAppLog[]

  @@map("patients")
}

// ---------- Appointments ----------

model Appointment {
  id          String            @id @default(cuid())
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id])
  chairId     String
  chair       Chair             @relation(fields: [chairId], references: [id])
  dentistId   String
  dentist     User              @relation("AppointmentDentist", fields: [dentistId], references: [id])
  treatmentPlanId String?
  treatmentPlan   TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id])

  scheduledAt DateTime
  durationMin Int               @default(30)
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime          @default(now())

  toothProcedures ToothProcedure[]
  whatsappLogs    WhatsAppLog[]

  @@index([chairId, scheduledAt])
  @@map("appointments")
}

// ---------- Treatments & Billing ----------

// كتالوج ثابت لأنواع العلاج (ثنائي اللغة)
model TreatmentType {
  id           String  @id @default(cuid())
  nameAr       String
  nameEn       String
  defaultPrice Decimal @db.Decimal(10, 2)
  description  String?

  treatmentPlans TreatmentPlan[]

  @@map("treatment_types")
}

model TreatmentPlan {
  id              String               @id @default(cuid())
  patientId       String
  patient         Patient              @relation(fields: [patientId], references: [id])
  treatmentTypeId String
  treatmentType   TreatmentType        @relation(fields: [treatmentTypeId], references: [id])
  status          TreatmentPlanStatus  @default(ONGOING)
  totalPrice      Decimal              @db.Decimal(10, 2)
  startDate       DateTime             @default(now())
  notes           String?

  appointments    Appointment[]
  toothProcedures ToothProcedure[]
  invoices        Invoice[]

  @@map("treatment_plans")
}

// سجل تاريخي دائم (Event Log) — لا يُحدَّث، فقط يُضاف
model ToothProcedure {
  id              String         @id @default(cuid())
  patientId       String
  patient         Patient        @relation(fields: [patientId], references: [id])
  toothNumberFdi  String         // مثال: "11", "48"
  appointmentId   String?
  appointment     Appointment?   @relation(fields: [appointmentId], references: [id])
  treatmentPlanId String?
  treatmentPlan   TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id])
  performedById   String
  performedBy     User           @relation("PerformedBy", fields: [performedById], references: [id])

  procedureType   String   // مثال: "حشو", "خلع", "تنظيف"
  notes           String?
  performedAt     DateTime @default(now())

  @@index([patientId, toothNumberFdi])
  @@map("tooth_procedures")
}

model Invoice {
  id              String        @id @default(cuid())
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id])
  treatmentPlanId String?
  treatmentPlan   TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id])

  amount        Decimal       @db.Decimal(10, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(10, 2)
  status        InvoiceStatus @default(UNPAID)
  issuedAt      DateTime      @default(now())

  payments Payment[]

  @@map("invoices")
}

model Payment {
  id             String        @id @default(cuid())
  invoiceId      String
  invoice        Invoice       @relation(fields: [invoiceId], references: [id])
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod @default(CASH)
  paidAt         DateTime      @default(now())
  receivedById   String
  receivedBy     User          @relation("ReceivedBy", fields: [receivedById], references: [id])

  @@map("payments")
}

// ---------- WhatsApp Integration ----------

model WhatsAppLog {
  id            String              @id @default(cuid())
  patientId     String
  patient       Patient             @relation(fields: [patientId], references: [id])
  appointmentId String?
  appointment   Appointment?        @relation(fields: [appointmentId], references: [id])
  messageType   WhatsAppMessageType
  status        WhatsAppStatus      @default(PENDING)
  sentAt        DateTime?
  createdAt     DateTime            @default(now())

  @@map("whatsapp_logs")
}
